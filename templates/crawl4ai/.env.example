# Crawl4AI self-hosted API (Arcane template).
# Copy reviewed values into your Arcane project environment on deploy.

# Port published on the host for the Crawl4AI API.
PORT=11235

# Required: static operator token. The server refuses a non-loopback bind
# without a credential, so the published port stays unreachable until this is
# set to a strong unique value.
CRAWL4AI_API_TOKEN=change-me-crawl4ai-token

# Opt-in deep crawling (one request can fetch many pages). Off by default.
CRAWL4AI_ALLOW_DEEP_CRAWL=false

# LLM extraction (optional). The server resolves providers via litellm, which
# reads the standard provider variables below. Leave empty to run crawling and
# markdown generation without a model provider.
LLM_PROVIDER=
LLM_API_KEY=
LLM_TEMPERATURE=
LLM_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_TOKEN=

# Corporate egress proxy (optional). Only needed when the host reaches the
# internet through an HTTP proxy; the server chains through it while keeping
# its SSRF protections. Leave empty otherwise.
CRAWL4AI_UPSTREAM_PROXY=

# Risky features stay off unless you need them. /execute_js runs caller
# JavaScript in the crawl page and hooks can execute server-side code.
CRAWL4AI_EXECUTE_JS_ENABLED=false
CRAWL4AI_HOOKS_ENABLED=false
