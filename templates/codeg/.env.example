# Codeg multi-agent coding workspace (Arcane template).
# Copy reviewed values into your Arcane project environment on deploy.

# Port published on the host for the Codeg web UI / API.
PORT=3080

# Required: access token for the web UI and API. The server persists a
# generated token on first start when this is empty, but set a strong unique
# value here so recreating the container does not rotate it. If you lose it,
# the token is printed on stderr (check `docker logs`).
CODEG_TOKEN=change-me-codeg-token

# Port bridge for agent dev servers (shows an agent's `http://localhost:3000`
# inside the workbench). Default is the ten ports after CODEG_PORT. Set to
# `off` to disable, or use a hostname pattern instead (see below).
CODEG_BRIDGE_PORTS=3081-3090

# Name dev servers by hostname on :3080 instead of publishing the range above
# (e.g. `auto` behind wildcard DNS plus a reverse proxy). Leave empty for
# port mode. When set, the `3081-3090` publish in compose.yaml is unused.
CODEG_BRIDGE_HOST_PATTERN=

# Public hostname seen by browsers when behind a reverse proxy. Leave empty
# unless CODEG_BRIDGE_HOST_PATTERN points at proxied names.
CODEG_BRIDGE_PUBLIC_HOST=

# Agent filesystem policy: empty (default), `strict` (confine reads and
# writes to the session workspace), or `unrestricted`. Leave empty unless
# you serve untrusted tenants.
CODEG_ACP_FS_POLICY=

# Extra writable roots for agents (`:`-separated absolute paths). Only needed
# when agent workspaces live outside the mounted projects.
CODEG_ACP_FS_EXTRA_ROOTS=
