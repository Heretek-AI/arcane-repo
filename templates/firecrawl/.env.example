# Firecrawl self-hosted stack (Arcane template).
# Copy reviewed values into your Arcane project environment on deploy.

# Port published on the host for the Firecrawl API.
PORT=3002

# Queue database (NuQ PostgreSQL). Keep api and database values consistent.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-firecrawl-postgres
POSTGRES_DB=postgres
POSTGRES_HOST=nuq-postgres
POSTGRES_PORT=5432

# Baseline runs without API authentication. Only set to true after provisioning
# the required database schema and application configuration.
USE_DB_AUTHENTICATION=false

# Internal service wiring (defaults match the compose file).
REDIS_URL=redis://redis:6379
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape

# Worker tuning.
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5

LOGGING_LEVEL=INFO

# AI features (extract, summarize). Leave empty to run without a model provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
MODEL_EMBEDDING_NAME=
OLLAMA_BASE_URL=

# Optional integrations. Leave empty unless you use them.
BULL_AUTH_KEY=
TEST_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_TOKEN=
SUPABASE_SERVICE_TOKEN=
AUTUMN_SECRET_KEY=
SLACK_WEBHOOK_URL=
SELF_HOSTED_WEBHOOK_URL=
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
SEARXNG_ENDPOINT=
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=
ALLOW_LOCAL_WEBHOOKS=false
BLOCK_MEDIA=false
